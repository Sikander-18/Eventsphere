PORT=5000
# URL-encode special characters in passwords. Example: @ becomes %40.
MONGO_URI=mongodb+srv://USER:URL_ENCODED_PASSWORD@cluster.mongodb.net/eventsphere?retryWrites=true&w=majority
JWT_SECRET=change_this_before_deploy
JWT_EXPIRES_IN=7d

GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.1-8b-instant

RAZORPAY_KEY_ID=rzp_test_xxxx
RAZORPAY_KEY_SECRET=xxxx

CLOUDINARY_CLOUD_NAME=xxxx
CLOUDINARY_API_KEY=xxxx
CLOUDINARY_API_SECRET=xxxx

GMAIL_USER=youremail@gmail.com
GMAIL_APP_PASSWORD=xxxx

CLIENT_URL=http://localhost:5173
